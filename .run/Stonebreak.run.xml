<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Stonebreak" type="Application" factoryName="Application">
    <option name="MAIN_CLASS_NAME" value="com.stonebreak.core.Main" />
    <module name="stonebreak-game" />
    <!-- JDK-8379129: Microsoft JDK 25.0.3 C2 crashes in allocation-merge analysis
         while compiling FrameRenderer (hs_err_pid12921 / hs_err_pid162649).
         Keep other escape analysis and C2 optimizations enabled. Remove these
         two workaround flags after verifying a JDK containing the upstream fix. -->
    <option name="VM_PARAMETERS" value="-XX:+UseZGC -Xms2g -Xmx8g -XX:+UseStringDeduplication -XX:+UseTLAB -XX:+ResizeTLAB -XX:+UnlockDiagnosticVMOptions -XX:-ReduceAllocationMerges --enable-native-access=ALL-UNNAMED --add-exports=java.base/sun.nio.ch=ALL-UNNAMED --add-exports=java.base/sun.security.util=ALL-UNNAMED" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <!-- Cenda (libcenda_kernels) comes packaged in the Open Mason engine-core jar since #388, so there is
           no engine build step. Dev loop against an OpenMason checkout: scripts/openmason-local.sh. -->
      <!-- Unpacks Open Mason's Cenda SDK (initialize) and rebuilds Stonebreak's own worldgen natives
           (stonebreak-game/native/pom.xml, exec:exec@worldgen-natives, #386). -->
      <option name="Maven.BeforeRunTask" enabled="true" file="$PROJECT_DIR$/stonebreak-game/native/pom.xml" goal="initialize exec:exec@worldgen-natives" />
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
