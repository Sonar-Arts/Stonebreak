<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Build Stonebreak Plugin" type="MavenRunConfiguration" factoryName="Maven">
    <!-- Builds the Open Mason drop-in plugin jar:
         openmason-plugin-stonebreak/target/openmason-plugin-stonebreak-<version>-dropin.jar
         (`-am` also rebuilds stonebreak-game, which the plugin bundles). Open Mason loads it from
         <data dir>/plugins or -Dopenmason.plugins.dir; a symlink there to this jar picks up every rebuild.
         Tests are skipped: run Testing/run-tests.sh for those, and scripts/plugin-dropin-check.sh to
         prove the jar registers ACTIVE in Open Mason's real loader. Honors .mvn/maven.config, so while
         scripts/openmason-local.sh has pinned a local Open Mason checkout, that build is what it compiles against.
         Close Open Mason and the game first: rebuilding target/classes under a live JVM breaks it. -->
    <MavenSettings>
      <option name="myGeneralSettings" />
      <option name="myRunnerSettings" />
      <option name="myRunnerParameters">
        <MavenRunnerParameters>
          <option name="profiles">
            <set />
          </option>
          <option name="goals">
            <list>
              <option value="package" />
              <option value="-pl" />
              <option value="openmason-plugin-stonebreak" />
              <option value="-am" />
              <option value="-DskipTests" />
            </list>
          </option>
          <option name="multimoduleDir" />
          <option name="pomFileName" />
          <option name="profilesMap">
            <map />
          </option>
          <option name="resolveToWorkspace" value="false" />
          <option name="workingDirPath" value="$PROJECT_DIR$" />
        </MavenRunnerParameters>
      </option>
    </MavenSettings>
    <method v="2" />
  </configuration>
</component>
