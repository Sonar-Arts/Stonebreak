<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.stonebreak</groupId>
        <artifactId>stonebreak-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>openmason-plugin-stonebreak</artifactId>
    <packaging>jar</packaging>

    <name>OpenMason Stonebreak Plugin</name>
    <description>
        Stonebreak's Open Mason plugin (#382): the Stonebreak game target, UI host, numeric-id
        registries, game-item viewport content and asset tooling. Depends on the tool and the game;
        the tool never depends on this module.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The version stamped into the drop-in jar's manifest (build.yml passes nightly-<sha>);
             local builds keep the POM version. -->
        <plugin.release.version>${project.version}</plugin.release.version>
    </properties>

    <dependencies>
        <!-- The Open Mason tool (Sonar-Arts/OpenMason, #388): its plain jar, version from the root POM -->
        <dependency>
            <groupId>com.openmason</groupId>
            <artifactId>openmason-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stonebreak</groupId>
            <artifactId>stonebreak-game</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- Testing (versions managed by parent POM) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <argLine>
                        --enable-native-access=ALL-UNNAMED
                        --add-opens=java.base/java.nio=org.lwjgl
                        --add-exports=java.base/sun.nio.ch=ALL-UNNAMED
                        --add-exports=java.base/sun.security.util=ALL-UNNAMED
                        -Dorg.lwjgl.util.Debug=false
                        -Dorg.lwjgl.util.NoChecks=true
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- openmason-plugin-stonebreak-<ver>-dropin.jar: the file users put in Open
                                 Mason's plugin folder (PluginManager.pluginDirs(): <data dir>/plugins or
                                 -Dopenmason.plugins.dir). Open Mason loads it on its own class loader over
                                 the editor's, finds the plugin through META-INF/services, and supplies the
                                 engine, LWJGL, Skija, ImGui, Netty, Jackson and logging itself. So the jar
                                 carries only the plugin, the game it reads (registries, SBO data, UI host)
                                 and the game's dependencies Open Mason does not have; build.yml fails if
                                 that list drifts from the dependency tree. Platform-independent: the
                                 game's natives (worldgen) and music are left out. The main artifact stays
                                 the plain jar. -->
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>dropin</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.stonebreak:*</include>
                                    <!-- Game-only dependencies (not on Open Mason's class path). -->
                                    <include>com.openmason:openmason-engine-voxel</include>
                                    <include>org.xerial:sqlite-jdbc</include>
                                    <include>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Loaded from the class path, not as modules: several
                                             module-infos would only collide. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- Signatures of shaded dependencies no longer match. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.stonebreak:stonebreak-game</artifact>
                                    <excludes>
                                        <!-- Game runtime only: music (~126 MB), the worldgen natives, the
                                             game's logging config (Open Mason's own applies). -->
                                        <exclude>songs/**</exclude>
                                        <exclude>natives/**</exclude>
                                        <exclude>logback.xml</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <!-- sqlite-jdbc / Jackson ship per-release classes. -->
                                        <Multi-Release>true</Multi-Release>
                                        <Implementation-Title>Open Mason Stonebreak plugin</Implementation-Title>
                                        <Implementation-Version>${plugin.release.version}</Implementation-Version>
                                        <OpenMason-Version>${openmason.version}</OpenMason-Version>
                                    </manifestEntries>
                                </transformer>
                                <!-- Merges the plugin's and the game's (UI theme) service files. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
