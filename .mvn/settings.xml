<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">
  
  <!-- CI (build.yml, worldgen-native.yml) passes this file with -s: Open Mason comes from GitHub
       Packages (#388), which needs a token even for public packages. Locally, put the same server
       (id "github", a read:packages token) in ~/.m2/settings.xml instead, or skip the token entirely
       with scripts/openmason-local.sh. -->
  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.GITHUB_TOKEN}</password>
    </server>
  </servers>

  <profiles>
    <profile>
      <id>stonebreak-java25</id>
      <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
      </properties>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>stonebreak-java25</activeProfile>
  </activeProfiles>
  
</settings>
