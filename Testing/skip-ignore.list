com.stonebreak.world.generation.FusedChunkGenParityTest
com.stonebreak.world.generation.NativeCarverIntegrationTest
com.stonebreak.world.generation.noise.TerrainNoiseParityTest
com.stonebreak.world.save.io.ChunkCodecZstdTest
