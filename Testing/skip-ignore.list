# Test classes whose skips are environment-gated (JUnit Assumptions), not
# regressions: they skip on machines without the native Cenda kernels
# (libcenda_kernels.so) or the game's worldgen natives (libstonebreak_worldgen.so,
# stonebreak-game/native, #386), without the NATIVE noise backend, or without the
# manual benchmark gate (-Dcenda.bench=true). The baseline diff in
# harness.py ignores NEWLY SKIPPED entries for these classes.
com.stonebreak.world.CendaChunkBenchmarkTest
com.stonebreak.world.chunk.api.mightyMesh.mmsIntegration.CendaMesherKernelTest
com.stonebreak.world.generation.FusedChunkGenParityTest
com.stonebreak.world.generation.NativeCarverIntegrationTest
com.stonebreak.world.generation.WorldgenNativesTest
com.stonebreak.world.generation.noise.TerrainNoiseParityTest
com.stonebreak.world.save.io.ChunkCodecZstdTest
com.stonebreak.world.bench.ChunkFootprintLabTest
com.stonebreak.world.bench.PulledQuadRenderTest

# FastLOD ring measurements (-Dstonebreak.bench=true).
com.stonebreak.world.bench.FastLodRingLabTest
com.stonebreak.world.fastlod.FastLodRingTickLabTest

# Real-display arena render check (-Dstonebreak.battletest.gl=true).
com.stonebreak.battletest.BattleTestRenderTest

# UI program spikes (#283): need the Cenda library (Lua host / Yoga) or a display
# (-Dstonebreak.ui.gl=true).
com.stonebreak.ui.scripting.LuaHostGameSmokeTest
com.stonebreak.rendering.UI.masonryUI.RenderTargetSpikeTest

# UI budget re-measurement on the machine at hand (#296, -Dui.bench=true).
