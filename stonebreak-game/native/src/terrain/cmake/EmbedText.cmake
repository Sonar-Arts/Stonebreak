# Writes OUT as a sequence of C++ raw string literals holding the text of IN (chunks under MSVC's 16 KB literal
# limit; adjacent literals concatenate). Local `#include "file"` lines are inlined (recursively, once per file), the
# way the DaedalusTGM kernel loader (kernels/native.py _read_source) hands NVRTC one self-contained program.
# Run as: cmake -DIN=<file> -DOUT=<file> -P EmbedText.cmake
function(_sbtg_inline path out_var)
    get_filename_component(_dir "${path}" DIRECTORY)
    file(READ "${path}" _text)
    string(REGEX MATCHALL "#include \"[^\"]+\"" _incs "${_text}")
    foreach(_inc IN LISTS _incs)
        string(REGEX REPLACE "#include \"([^\"]+)\"" "\\1" _name "${_inc}")
        get_filename_component(_ipath "${_dir}/${_name}" ABSOLUTE)
        get_property(_seen GLOBAL PROPERTY SBTG_EMBED_SEEN)
        if("${_ipath}" IN_LIST _seen)
            string(REPLACE "${_inc}" "" _text "${_text}")
        else()
            set_property(GLOBAL APPEND PROPERTY SBTG_EMBED_SEEN "${_ipath}")
            _sbtg_inline("${_ipath}" _sub)
            string(REPLACE "${_inc}" "${_sub}" _text "${_text}")
        endif()
    endforeach()
    set(${out_var} "${_text}" PARENT_SCOPE)
endfunction()

set_property(GLOBAL PROPERTY SBTG_EMBED_SEEN "")
_sbtg_inline("${IN}" _text)
string(LENGTH "${_text}" _len)
set(_out "")
set(_pos 0)
while(_pos LESS _len)
    string(SUBSTRING "${_text}" ${_pos} 12000 _chunk)
    string(APPEND _out "R\"SBTG_EMBED(${_chunk})SBTG_EMBED\"\n")
    math(EXPR _pos "${_pos} + 12000")
endwhile()
if(_out STREQUAL "")
    set(_out "\"\"\n")
endif()
file(WRITE "${OUT}.tmp" "${_out}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
