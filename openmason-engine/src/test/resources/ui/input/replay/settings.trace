move @play             true  focus=- hover=play_text []
down @play             true  focus=play hover=play_text [FOCUS_IN:play]
up @play               true  focus=play hover=play_text [CLICK:play_text]
down @options          true  focus=options hover=options_text [FOCUS_IN:options]
up @quit               true  focus=options hover=quit_text []
down 600 340           false focus=- hover=- []
up 600 340             false focus=- hover=- []
key TAB                true  focus=play* hover=- [NAVIGATE:root, FOCUS_IN:play]
key TAB                true  focus=options* hover=- [NAVIGATE:play, FOCUS_IN:options]
key UP                 true  focus=play* hover=- [NAVIGATE:options, FOCUS_IN:play]
key UP                 true  focus=play* hover=- [NAVIGATE:play]
key ENTER              true  focus=play* hover=- [SUBMIT:play, CLICK:play]
key TAB shift          true  focus=row5* hover=- [NAVIGATE:play, FOCUS_IN:row5]
down @name             true  focus=name hover=name [FOCUS_IN:name]
up @name               true  focus=name hover=name [CLICK:name]
text Steve1            true  focus=name hover=name [CHANGE:name]
key ENTER              true  focus=name hover=name []
key BACKSPACE          true  focus=name hover=name [CHANGE:name]
key ENTER              true  focus=name hover=name [COMMIT:name]
text x                 true  focus=name hover=name [CHANGE:name]
key ESCAPE             true  focus=name hover=name [CHANGE:name]
key ESCAPE             false focus=name hover=name [CANCEL:name]
down @quit             true  focus=quit hover=quit_text [FOCUS_IN:quit]
up @quit               true  focus=yes hover=- [CLICK:quit_text, FOCUS_IN:yes]
down @play             true  focus=yes hover=- []
up @play               true  focus=yes hover=- []
key TAB                true  focus=no* hover=- [NAVIGATE:yes, FOCUS_IN:no]
key ESCAPE             true  focus=quit hover=play_text [CANCEL:no, FOCUS_IN:quit]
key TAB                true  focus=name* hover=play_text [NAVIGATE:quit, FOCUS_IN:name]
hold DOWN              true  focus=apply* hover=play_text [NAVIGATE:name, FOCUS_IN:apply]
focus-lost             false focus=apply* hover=- []
release DOWN           false focus=apply* hover=- []
repeat ENTER           false focus=apply* hover=- []
move @list             true  focus=apply* hover=row4 []
wheel @list 1          true  focus=apply* hover=row3_text []
pad DPAD_RIGHT down    true  focus=apply* hover=row3_text [NAVIGATE:apply]
pad DPAD_RIGHT up      true  focus=apply* hover=row3_text []
pad DPAD_DOWN down     true  focus=row2* hover=row3_text [NAVIGATE:apply, FOCUS_IN:row2]
tick 0.3               false focus=row2* hover=row3_text []
tick 0.2               false focus=row4* hover=row3 [NAVIGATE:row2, FOCUS_IN:row3, NAVIGATE:row3, FOCUS_IN:row4]
tick 0.1               false focus=row5* hover=row4 [NAVIGATE:row4, FOCUS_IN:row5]
pad DPAD_DOWN up       true  focus=row5* hover=row4 []
pad A down             true  focus=row5* hover=row4 [SUBMIT:row5, CLICK:row5]
tick 1                 false focus=row5* hover=row4 []
pad A up               true  focus=row5* hover=row4 []
leave                  false focus=row5* hover=- []
screen-closed          false focus=- hover=- []
